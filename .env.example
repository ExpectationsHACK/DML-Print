# MongoDB connection string — from MongoDB Atlas (free tier), or a
# self-hosted/local instance. Include the database name in the path, e.g.
# mongodb+srv://user:pass@cluster.mongodb.net/dmlprint
MONGODB_URI=

# Auth.js session encryption — generate with: npx auth secret
AUTH_SECRET=

# Vercel Blob — Storage tab in your Vercel project → create a Blob store.
BLOB_READ_WRITE_TOKEN=

# Paystack — Settings → API Keys & Webhooks (use test keys until launch)
PAYSTACK_SECRET_KEY=

# wa.me number, digits only, country code first (no "+")
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

# Used to build the Paystack callback URL. Set to your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
